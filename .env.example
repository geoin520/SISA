# Site
NEXT_PUBLIC_SITE_URL=https://sisa.ing

# Data cache TTL in seconds
DATA_CACHE_TTL=3600

# MSRC CVRF API
MSRC_API_BASE=https://api.msrc.microsoft.com

# NVD CVE API
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0
# Optional NVD API key to raise rate limits
NVD_API_KEY=

# CISA KEV
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# Cron protection
CRON_SECRET=change-me

# Email (Resend)
EMAIL_FROM=alert@sisa.ing
RESEND_API_KEY=
# Fallback subscriber list (comma-separated, used when Vercel KV is unavailable)
EMAIL_SUBSCRIBERS=

# Vercel KV (auto-injected on Vercel; set manually for local dev)
# KV_REST_API_URL=
# KV_REST_API_KEY=
# KV_REST_TOKEN=
