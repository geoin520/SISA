{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/fetch-data",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/send-digest",
      "schedule": "0 1 * * *"
    }
  ]
}
